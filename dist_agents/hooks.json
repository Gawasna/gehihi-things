{
  "gehihi-commit-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -File ./hooks/gehihi/gehihi-commit-gate.ps1",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
